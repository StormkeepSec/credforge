# Normalize line endings to LF everywhere (shell scripts and Dockerfiles break with CRLF).
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary

# Vendored JSON-LD contexts and JSON schemas are byte-for-byte copies of published files, pinned by
# SHA-256 (packages/ob3/src/vendor/README.md). Some are published with CRLF, so never convert them.
packages/ob3/src/vendor/contexts/** -text
packages/ob3/src/vendor/schemas/** -text
