# credforge database backups (deploy/backup.sh). Copy to backup.env next to .env, chmod 600.
# Only the "backup" compose service reads this file: the app and worker never see this key.
# Backups are encrypted with a key derived from CREDFORGE_MASTER_KEY (in .env), so restoring
# needs that key too. Keep it backed up offline (design plan §13.4).

# The backups bucket (a private Space in the droplet's region) and a limited access key with
# Read/Write/Delete on that bucket only. Endpoint and region default to S3_ENDPOINT / S3_REGION.
BACKUP_S3_BUCKET=credforge-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
# BACKUP_S3_REGION=sfo3
# BACKUP_S3_FORCE_PATH_STYLE=false

# Object key prefix, days to keep backups, and how many of the newest to keep regardless.
BACKUP_PREFIX=postgres/
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=7
