# credforge production configuration for docker compose.
# Copy to .env and fill in. Never commit .env. On a server it must be readable by its owner only
# (mode 600; deploy/ship.sh refuses otherwise): docs/deployment.md shows how to copy it there.
# Any secret can come from a file instead (Docker secrets): set NAME_FILE=/run/secrets/name.

# Public origin of this instance. PERMANENT: every credential you issue embeds URLs under it,
# and the app refuses to start if it changes later. Use http://localhost:3000 only for a local trial.
PUBLIC_BASE_URL=https://credforge.app

# ---- Database ----
# Two roles: migrations run as the owner (POSTGRES_PASSWORD); the app and worker connect as a
# restricted role that migrate creates (POSTGRES_APP_PASSWORD). That role can't change or delete
# the audit log. Use URL-safe characters for both, e.g. the output of:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=

# ---- Secrets ----
# Signs sessions and encrypts two-step verification secrets. At least 32 characters:
#   openssl rand -hex 32
# Don't change it once people have turned on two-step verification.
AUTH_SECRET=

# Encrypts every issuer's private signing key (32 bytes):
#   openssl rand -base64 32
# BACK IT UP SEPARATELY FROM THE DATABASE. Without it nothing new can be signed and revocations
# stop working. The app refuses to start with a different key than the one it was set up with.
CREDFORGE_MASTER_KEY=
# CREDFORGE_MASTER_KEY_FILE=/run/secrets/credforge_master_key

# ---- Email (award emails, verification, invitations, approval notices) ----
# sendgrid: SendGrid's v3 Web API over HTTPS (credforge.app; DigitalOcean blocks SMTP ports).
# smtp:     any SMTP server (self-hosters), e.g. smtp://user:pass@smtp.example.org:2525
# log:      print emails to the worker log instead of sending them (local trials only; logs links).
EMAIL_TRANSPORT=sendgrid
# Award emails go out as "{issuer} via credforge" from this address, with Reply-To set to the
# issuer's contact address. Authenticate the domain in SendGrid (Domain Authentication).
EMAIL_FROM=credforge <awards@credforge.app>
# A restricted SendGrid API key with only the "Mail Send" permission.
SENDGRID_API_KEY=
# SENDGRID_API_KEY_FILE=/run/secrets/sendgrid_api_key
# Signed Event Webhook (delivery and bounce status): the verification key from SendGrid's
# Mail Settings > Event Webhook, after turning on "Signed Event Webhook Requests". Point the
# webhook at {PUBLIC_BASE_URL}/api/webhooks/sendgrid. Leave it empty to turn the endpoint off.
SENDGRID_WEBHOOK_PUBLIC_KEY=
# For EMAIL_TRANSPORT=smtp:
# SMTP_URL=smtp://user:password@smtp.example.org:2525

# Award emails one organization may send in any 24 hours (a guard against a compromised account).
# Platform admins can set a different limit per organization. 0 means no limit.
DEFAULT_ORG_DAILY_SEND_LIMIT=1000

# ---- Rate limits (in memory, per minute; 0: no limit). /status/ is never limited. ----
# Behind nginx, TRUST_PROXY must be set so the client IP is the real one.
# Checks per client IP on /verify and POST /api/v1/verify together.
VERIFY_RATE_LIMIT=20
# Requests per API key.
API_RATE_LIMIT=300
# Claim links and invitation links opened per client IP.
CLAIM_RATE_LIMIT=30
# Sign-in, sign-up, password reset and two-step code limits per client IP (Better Auth). On by
# default in production.
# AUTH_RATE_LIMIT=true

# ---- Moderation (docs/abuse-handling.md) ----
# Whose new images and public text wait for a platform admin before public pages show them:
#   untrusted (default): every org a platform admin hasn't marked trusted
#   all:                 every org, trusted or not
#   off:                 none (the word list and reports still hold content)
MODERATION_REVIEW=untrusted
# Your own word list, one term per line ("=term" matches whole words only). Text containing a
# listed term is held for review, never refused. credforge ships none: keep the file outside the
# repository and mount it read-only. Read at start-up; restart the app after changing it.
# MODERATION_TEXT_BLOCKLIST_FILE=/run/secrets/moderation-blocklist.txt
# Image and CSV uploads per org per hour, and stored files per org in MB (0: no limit). Platform
# admins can set an org's own on the Platform screen.
ORG_UPLOAD_RATE_LIMIT=60
ORG_STORAGE_QUOTA_MB=500
# Reports from the "Report a problem" form per client IP per hour (0: no limit).
REPORT_RATE_LIMIT=10

# ---- Contacts and legal pages ----
# The abuse contact: offered on the "Report a problem" form on public badge, achievement and issuer
# pages (reports themselves are stored for the moderation queue and emailed to the platform
# admins), named on /privacy and /terms, and the Reply-To of moderation emails to org owners, so
# their appeals reach it. It needs an inbound mail host: SendGrid only sends.
ABUSE_EMAIL=abuse@credforge.app
# Vulnerability reports: served as /.well-known/security.txt and named in the privacy policy.
SECURITY_EMAIL=security@credforge.app
# Privacy requests, named on /privacy (defaults to ABUSE_EMAIL).
# PRIVACY_EMAIL=privacy@credforge.app
# Who runs this instance, as /privacy and /terms name it (e.g. a company name and postal address).
# OPERATOR_NAME=
# /privacy and /terms say "Draft for review: not in effect yet" until this is false. Set it to
# false only after you have reviewed them (ideally with legal advice).
LEGAL_PAGES_DRAFT=true

# ---- File storage (badge images, logos) ----
# s3:    any S3-compatible bucket; on credforge.app a private DigitalOcean Space. Images are served
#        through the app at permanent {PUBLIC_BASE_URL} URLs, never at storage URLs.
# local: a directory in the container (the "uploads" volume). Back it up with the database.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
S3_REGION=sfo3
S3_BUCKET=credforge-prod
# A limited access key with Read/Write/Delete on this bucket only.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_access_key
# Path-style URLs (https://host/bucket/key), for S3-compatible servers that need them.
# S3_FORCE_PATH_STYLE=false

# ---- Sign-in ----
# approval: anyone can sign up and set up an org; a platform admin approves it before it can
#           award to people outside the org (credforge.app).
# open:     new orgs are active at once.
# invite:   accounts only by invitation; only platform admins create orgs.
SIGNUP_MODE=approval

# Owners, admins and platform admins must pass a credforge second factor (TOTP) after any
# sign-in, including Google and Microsoft.
REQUIRE_MFA_FOR_ADMINS=true

# "Continue with Google": set both to turn it on. Redirect URI:
#   {PUBLIC_BASE_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# "Continue with Microsoft" (work, school and personal accounts). Redirect URI:
#   {PUBLIC_BASE_URL}/api/auth/callback/microsoft
# Add the optional ID token claim xms_edov in Entra; without it credforge sends its own
# verification email before a Microsoft account can be used.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ---- Proxy and logging ----
# The app port is bound to 127.0.0.1, so only your host nginx can reach it.
# Trust its X-Forwarded-For / X-Forwarded-Proto headers.
TRUST_PROXY=true

LOG_LEVEL=info

# Show the marketing landing page at / (set to false to send visitors to /login).
LANDING_PAGE=true

# Host port for the app (always bound to 127.0.0.1).
# CREDFORGE_PORT=3000

# ---- Backups ----
# The nightly database backup (deploy/backup.sh) reads its bucket key from backup.env, not from
# this file, so the app and worker never hold it: cp backup.env.example backup.env.
# See docs/restore-drill.md.
