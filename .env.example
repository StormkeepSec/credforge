# credforge production configuration for docker compose.
# Copy to .env and fill in. Never commit .env.
# Any secret can come from a file instead (Docker secrets): set NAME_FILE=/run/secrets/name.

# Public origin of this instance. PERMANENT: every credential you issue embeds URLs under it,
# and the app refuses to start if it changes later. Use http://localhost:3000 only for a local trial.
PUBLIC_BASE_URL=https://credforge.app

# ---- Database ----
# Two roles: migrations run as the owner (POSTGRES_PASSWORD); the app and worker connect as a
# restricted role that migrate creates (POSTGRES_APP_PASSWORD). That role can't change or delete
# the audit log. Use URL-safe characters for both, e.g. the output of:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=

# ---- Secrets ----
# Signs sessions and encrypts two-step verification secrets. At least 32 characters:
#   openssl rand -hex 32
# Don't change it once people have turned on two-step verification.
AUTH_SECRET=

# Encrypts every issuer's private signing key (32 bytes):
#   openssl rand -base64 32
# BACK IT UP SEPARATELY FROM THE DATABASE. Without it nothing new can be signed and revocations
# stop working. The app refuses to start with a different key than the one it was set up with.
CREDFORGE_MASTER_KEY=
# CREDFORGE_MASTER_KEY_FILE=/run/secrets/credforge_master_key

# ---- Email (verification, invitations, approval notices) ----
# smtp: any SMTP server, e.g. SendGrid's on port 2525 (DigitalOcean blocks 25/465/587).
# log: print emails to the app log instead of sending them (local trials only; logs the links).
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://apikey:YOUR_SENDGRID_API_KEY@smtp.sendgrid.net:2525
EMAIL_FROM=credforge <no-reply@credforge.app>

# ---- Sign-in ----
# approval: anyone can sign up and set up an org; a platform admin approves it before it can
#           award to people outside the org (credforge.app).
# open:     new orgs are active at once.
# invite:   accounts only by invitation; only platform admins create orgs.
SIGNUP_MODE=approval

# Owners, admins and platform admins must pass a credforge second factor (TOTP) after any
# sign-in, including Google and Microsoft.
REQUIRE_MFA_FOR_ADMINS=true

# "Continue with Google": set both to turn it on. Redirect URI:
#   {PUBLIC_BASE_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# "Continue with Microsoft" (work, school and personal accounts). Redirect URI:
#   {PUBLIC_BASE_URL}/api/auth/callback/microsoft
# Add the optional ID token claim xms_edov in Entra; without it credforge sends its own
# verification email before a Microsoft account can be used.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ---- Proxy and logging ----
# The app port is bound to 127.0.0.1, so only your host nginx can reach it.
# Trust its X-Forwarded-For / X-Forwarded-Proto headers.
TRUST_PROXY=true

LOG_LEVEL=info

# Show the marketing landing page at / (set to false to send visitors to /login).
LANDING_PAGE=true

# Host port for the app (always bound to 127.0.0.1).
# CREDFORGE_PORT=3000
