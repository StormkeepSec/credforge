# Optional overrides for `pnpm dev`. Copy to .env.development if you need any of them.
# Without this file, development uses the built-in defaults shown here.

# PUBLIC_BASE_URL=http://localhost:5173
# The app connects as a restricted role that `pnpm db:migrate` creates; migrations run as the owner.
# DATABASE_URL=postgres://credforge_app:credforge_app@localhost:5432/credforge
# MIGRATION_DATABASE_URL=postgres://credforge:credforge@localhost:5432/credforge
# LOG_LEVEL=debug

# Email goes to Mailpit (http://localhost:8025). Use `log` to print it to the console instead.
# EMAIL_TRANSPORT=smtp
# SMTP_URL=smtp://localhost:1025

# Uploaded images go to data/uploads in the repository (git-ignored). To try the s3 driver against
# the credforge-dev Space, set these (a dev-only limited key):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_REGION=nyc3
# S3_BUCKET=credforge-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# The s3 driver's integration tests run against a real bucket only when these are set in the
# shell running `pnpm test`: S3_TEST_ENDPOINT, S3_TEST_REGION, S3_TEST_BUCKET,
# S3_TEST_ACCESS_KEY_ID, S3_TEST_SECRET_ACCESS_KEY.

# DEFAULT_ORG_DAILY_SEND_LIMIT=1000

# SIGNUP_MODE=approval
# REQUIRE_MFA_FOR_ADMINS=true

# Development OAuth clients. Redirect URIs:
#   http://localhost:5173/api/auth/callback/google
#   http://localhost:5173/api/auth/callback/microsoft
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
