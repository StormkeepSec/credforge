# Optional overrides for `pnpm dev`. Copy to .env.development if you need any of them.
# Without this file, development uses the built-in defaults shown here.

# PUBLIC_BASE_URL=http://localhost:5173
# The app connects as a restricted role that `pnpm db:migrate` creates; migrations run as the owner.
# DATABASE_URL=postgres://credforge_app:credforge_app@localhost:5432/credforge
# MIGRATION_DATABASE_URL=postgres://credforge:credforge@localhost:5432/credforge
# LOG_LEVEL=debug

# Email goes to Mailpit (http://localhost:8025). Use `log` to print it to the console instead.
# EMAIL_TRANSPORT=smtp
# SMTP_URL=smtp://localhost:1025

# SIGNUP_MODE=approval
# REQUIRE_MFA_FOR_ADMINS=true

# Development OAuth clients. Redirect URIs:
#   http://localhost:5173/api/auth/callback/google
#   http://localhost:5173/api/auth/callback/microsoft
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
